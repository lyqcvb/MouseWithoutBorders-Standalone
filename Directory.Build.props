<Project>
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <CoreTargetFramework>net10.0</CoreTargetFramework>
    <TargetFramework>$(CoreTargetFramework)-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
    <!-- The extracted sources predate the current analyzer ruleset; analyzers stay off until they are reintroduced. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1416;SYSLIB1054;CS8981</NoWarn>
    <ArtifactsPath>$(RepoRoot)artifacts</ArtifactsPath>
    <BaseOutputPath>$(ArtifactsPath)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ArtifactsPath)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <Company>Microsoft Corporation</Company>
    <Product>Mouse Without Borders</Product>
    <Authors>Microsoft Corporation</Authors>
    <Copyright>Copyright (C) Microsoft Corporation. All rights reserved.</Copyright>
  </PropertyGroup>
</Project>
